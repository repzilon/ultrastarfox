VER := 2.2

# The UltraStarFox builds cannot be done in parallel because its build 
# system can only use the same intermediate directory. Do not replace 
# make with $(MAKE) for this reason
SF-U.SFC: 
	# TODO : Generate or copy USA config
	make -f Makefile log
	mv SF.SFC SF-U.SFC

SF-J.SFC:
	# TODO : Generate or copy Japan config
	make -f Makefile log
	mv SF.SFC SF-J.SFC

SF-E.SFC:
	# TODO : Generate or copy Europe config
	make -f Makefile log
	mv SF.SFC SF-E.SFC

SF-G.SFC:
	# TODO : Generate or copy Germany config
	make -f Makefile log
	mv SF.SFC SF-G.SFC

releases/Release\ $(VER)/USA\ Patches:
	mkdir -p "releases/Release $(VER)/USA Patches"

releases/Release\ $(VER)/Japan\ Patches:
	mkdir -p "releases/Release $(VER)/Japan Patches"

releases/Release\ $(VER)/PAL\ Patches:
	mkdir -p "releases/Release $(VER)/PAL Patches"

#flips: https://git.disroot.org/Sir_Walrus/Flips/archive/master.tar.gz

releases/Release\ $(VER)/USA\ Patches/UltraStarFox\ (USA)\ $(VER).bps: flips baseroms/Star\ Fox\ (USA).sfc SF-U.SFC releases/Release\ $(VER)/USA\ Patches
	@echo "Making USA rev 0 patches..."
	flips --create --bps-delta "./baseroms/Star Fox (USA).sfc" SF-U.SFC "./releases/Release $(VER)/USA Patches/UltraStarFox (USA) $(VER).bps"

releases/Release\ $(VER)/USA Patches/UltraStarFox\ (USA)\ (Rev\ 1)\ $(VER).bps: flips baseroms/Star\ Fox\ (USA)\ (Rev\ 1).sfc SF-U.SFC releases/Release\ $(VER)/USA\ Patches
	@echo "Making USA rev 1 patches..."
	flips --create --bps-delta "./baseroms/Star Fox (USA) (Rev 1).sfc" SF-U.SFC "./releases/Release $(VER)/USA Patches/UltraStarFox (USA) (Rev 1) $(VER).bps"

releases/Release\ $(VER)/USA\ Patches/UltraStarFox\ (USA)\ (Rev\ 2)\ $(VER).bps: flips baseroms/Star\ Fox\ (USA)\ (Rev\ 2).sfc SF-U.SFC releases/Release\ $(VER)/USA\ Patches
	@echo "Making USA rev 2 patches..."
	flips --create --bps-delta "./baseroms/Star Fox (USA) (Rev 2).sfc" SF-U.SFC "./releases/Release $(VER)/USA Patches/UltraStarFox (USA) (Rev 2) $(VER).bps"

releases/Release\ $(VER)/Japan\ Patches/UltraStarFox\ (Japan)\ $(VER).bps: flips baseroms/Star\ Fox\ (Japan).sfc SF-J.SFC releases/Release\ $(VER)/Japan\ Patches
	@echo "Making JP rev 0 patches..."
	flips --create --bps-delta "./baseroms/Star Fox (Japan).sfc" SF-J.SFC "./releases/Release $(VER)/Japan Patches/UltraStarFox (Japan) $(VER).bps"

releases/Release\ $(VER)/Japan\ Patches/UltraStarFox\ (Japan)\ (Rev\ 1)\ $(VER).bps: flips baseroms/Star\ Fox\ (Japan)\ (Rev\ 1).sfc SF-J.SFC releases/Release\ $(VER)/Japan\ Patches
	@echo "Making JP rev 1 patches..."
	flips --create --bps-delta "./baseroms/Star Fox (Japan) (Rev 1).sfc" SF-J.SFC "./releases/Release\ $(VER)/USA Patches/UltraStarFox (Japan) (Rev 1) $(VER).bps"

releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Europe)\ $(VER).bps: flips baseroms/Star\ Fox\ (Europe).sfc SF-E.SFC releases/Release\ $(VER)/PAL\ Patches
	@echo "Making PAL rev 0 patches..."
	flips --create --bps-delta "./baseroms/Starwing (Europe).sfc" SF-J.SFC "./releases/Release $(VER)/PAL Patches/UltraStarFox (Europe) $(VER).bps"

releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Europe)\ (Rev\ 1)\ $(VER).bps: flips baseroms/Star\ Fox\ (Europe)\ (Rev\ 1).sfc SF-E.SFC releases/Release\ $(VER)/PAL\ Patches
	@echo "Making PAL rev 1 patches..."
	flips --create --bps-delta "./baseroms/Starwing (Europe) (Rev 1).sfc" SF-J.SFC "./releases/Release $(VER)/PAL Patches/UltraStarFox (Europe) (Rev 1) $(VER).bps"

releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Germany)\ $(VER).bps: flips baseroms/Star\ Fox\ (Germany).sfc SF-G.SFC releases/Release\ $(VER)/PAL\ Patches
	@echo "Making PAL-G patches..."
	flips --create --bps-delta "./baseroms/Starwing (Germany).sfc" SF-J.SFC "./releases/Release $(VER)/PAL Patches/UltraStarFox (Germany) $(VER).bps"

all: releases/Release\ $(VER)/USA\ Patches/UltraStarFox\ (USA)\ $(VER).bps releases/Release\ $(VER)/USA\ Patches/UltraStarFox\ (USA)\ (Rev\ 1)\ $(VER).bps releases/Release\ $(VER)/USA\ Patches/UltraStarFox\ (USA)\ (Rev\ 2)\ $(VER).bps releases/Release\ $(VER)/Japan\ Patches/UltraStarFox\ (Japan)\ $(VER).bps releases/Release\ $(VER)/Japan\ Patches/UltraStarFox\ (Japan)\ (Rev\ 1)\ $(VER).bps releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Europe)\ $(VER).bps releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Europe)\ (Rev\ 1)\ $(VER).bps releases/Release\ $(VER)/PAL\ Patches/UltraStarFox\ (Germany)\ $(VER).bps
	@echo "All done!"

clean:
	$(MAKE) -f Makefile clean
	rm -f SF-U.SFC
	rm -f SF-J.SFC
	rm -f SF-E.SFC
	rm -f SF-G.SFC
	rm -f "releases/Release $(VER)/USA Patches/UltraStarFox*.bps"
	rm -f "releases/Release $(VER)/Japan Patches/UltraStarFox*.bps"
	rm -f "releases/Release $(VER)/PAL Patches/UltraStar*.bps"

.PHONY: all clean